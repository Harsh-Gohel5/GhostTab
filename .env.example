# Copy to .env at the repository root when configuring integrations.
# This foundation works without credentials. Never put secrets in VITE_* variables.
GHOSTTAB_ENVIRONMENT=development

GHOSTTAB_DATABASE_URL=sqlite:///.ghosttab/ghosttab.db
GHOSTTAB_AUTH_MODE=local
GHOSTTAB_FRONTEND_URL=http://127.0.0.1:5173

# Google Calendar: follow docs/setup.md. Keep credentials server-side.
# GHOSTTAB_GOOGLE_CLIENT_ID=
# GHOSTTAB_GOOGLE_CLIENT_SECRET=
# GHOSTTAB_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/connections/google/callback
# GHOSTTAB_TOKEN_ENCRYPTION_KEY=

# Optional Jira Cloud selected issues: docs/jira-source.md. Live setup is deferred.
# GHOSTTAB_JIRA_CLIENT_ID=
# GHOSTTAB_JIRA_CLIENT_SECRET=
# GHOSTTAB_JIRA_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/jira/callback

# Optional Teams selected chats: docs/teams-source.md. Work/school tenant only.
# GHOSTTAB_TEAMS_TENANT_ID=
# GHOSTTAB_TEAMS_CLIENT_ID=
# GHOSTTAB_TEAMS_CLIENT_SECRET=
# GHOSTTAB_TEAMS_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/teams/callback

# Meta stays disabled until credits and billing settings are verified.
GHOSTTAB_ALLOW_MODEL_REQUESTS=false
GHOSTTAB_MODEL_BUDGET_USD=10
# MODEL_API_KEY=
# META_MODEL_ID=muse-spark-1.3

# Optional future hosted identity; not needed for local development.
# GHOSTTAB_SUPABASE_URL=
# GHOSTTAB_SUPABASE_PUBLISHABLE_KEY=
