# Copy to .env at the repository root when configuring integrations.
# This foundation works without credentials. Never put secrets in VITE_* variables.
GHOSTTAB_ENVIRONMENT=development

# Reserved for the GitHub App integration; not consumed by this foundation yet.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_WEBHOOK_SECRET=

# Reserved for the Meta integration. Verify your granted endpoint and model first.
# META_API_KEY=
# META_API_BASE_URL=
# META_MODEL_ID=
